<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="LOGSTASH" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"empresagi","environment":"producao"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger_name</logger>
                <thread>thread_name</thread>
                <level>level</level>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>2048</maxLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- Suprime WARNs de HTTP method not supported (health checks, bots, etc) -->
    <logger name="org.springframework.web.servlet.mvc.support.DefaultHandlerExceptionResolver" level="ERROR"/>

    <!-- Suprime logs verbosos do Spring Security em producao -->
    <logger name="org.springframework.security" level="ERROR"/>

    <!-- Suprime logs verbosos do Tomcat/WebSocket -->
    <logger name="org.apache.tomcat" level="ERROR"/>
    <logger name="org.apache.catalina" level="ERROR"/>

    <!-- Modulo validacao-ad -->
    <logger name="keysson.apis.validacaoad" level="INFO"/>

    <!-- Modulo empresa -->
    <logger name="keysson.apis.empresa" level="INFO"/>

    <!-- Modulo estoque: WARN em producao, INFO em desenvolvimento -->
    <logger name="keysson.apis.estoque" level="WARN"/>

    <!-- HikariCP: loga tentativas de conexao em WARN -->
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- Hibernate/SQL: suprime verboso, mantem erros -->
    <logger name="org.hibernate" level="ERROR"/>
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="WARN"/>
    <logger name="org.hibernate.event.internal" level="ERROR"/>

    <!-- PostgreSQL driver -->
    <logger name="org.postgresql" level="WARN"/>

    <!-- Spring Boot startup: permite INFOs importantes -->
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.springframework.context" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="LOGSTASH"/>
    </root>
</configuration>
