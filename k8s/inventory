apiVersion: apps/v1
kind: Deployment
metadata:
  name: estoque-deployment
  labels:
    app: estoque
spec:
  replicas: 1
  selector:
    matchLabels:
      app: estoque
  template:
    metadata:
      labels:
        app: estoque
    spec:
      containers:
      - name: estoque
        image: keyssong/estoque:latest
        ports:
        - containerPort: 8090
        envFrom:
        - configMapRef:
            name: config-api
        - secretRef:
            name: secret-api
---
apiVersion: v1
kind: Service
metadata:
  name: estoque-service
spec:
  selector:
    app: estoque
  ports:
    - protocol: TCP
      port: 8090
      targetPort: 8090
  type: ClusterIP
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: estoque-servicemonitor
  labels:
    release: prometheus-stack
spec:
  selector:
    matchLabels:
      app: estoque
  endpoints:
  - port: web
    path: /actuator/prometheus
    interval: 30s
