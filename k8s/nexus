apiVersion: v1
kind: Namespace
metadata:
  name: nexus
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
  namespace: nexus
data:
  SERVER_PORT: "8085"
  DB_HOST: postgres-service
  DB_PORT: "5432"
  DB_NAME: managerPROD
  HOST_RABBIT: rabbitmq-service
  PORT_RABBIT: "5672"
  SPRING_PROFILES_ACTIVE: prod
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: nexus
type: Opaque
stringData:
  DB_USER: postgres
  DB_PASSWORD: postgresql
  USER_RABBIT: guest
  PASSWORD_RABBIT: guest
  SECRET_KEY: C6slIxtVM5y1mBrCphrqygYNVoN7t5V/03NVfJddayQ=
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nexus-deployment
  namespace: nexus
  labels:
    app: nexus
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nexus
  template:
    metadata:
      labels:
        app: nexus
    spec:
      containers:
      - name: nexus
        image: keyssong/nexus-multithread:latest
        imagePullPolicy: Always
        ports:
        - containerPort: 8085
        envFrom:
        - configMapRef:
            name: app-config
        - secretRef:
            name: app-secret
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /actuator/health/liveness
            port: 8085
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 10
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /actuator/health/readiness
            port: 8085
          initialDelaySeconds: 30
          periodSeconds: 15
          timeoutSeconds: 5
          failureThreshold: 2
---
apiVersion: v1
kind: Service
metadata:
  name: nexus-service
  namespace: nexus
  labels:
    app: nexus
spec:
  selector:
    app: nexus
  ports:
    - protocol: TCP
      port: 8085
      targetPort: 8085
  type: ClusterIP
