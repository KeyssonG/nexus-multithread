apiVersion: apps/v1
kind: Deployment
metadata:
  name: validacaoad-deployment
  labels:
    app: validacaoad
spec:
  replicas: 1
  selector:
    matchLabels:
      app: validacaoad
  template:
    metadata:
      labels:
        app: validacaoad
    spec:
      containers:
        - name: validacaoad
          image: keyssong/validacaoad:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 8089
          envFrom:
            - configMapRef:
                name: app-config
            - secretRef:
                name: app-secret
---
apiVersion: v1
kind: Service
metadata:
  name: validacaoad-service
  namespace: producao
  labels:
    app: validacaoad
spec:
  selector:
    app: validacaoad
  ports:
    - name: http
      protocol: TCP
      port: 8089
      targetPort: 8089
      nodePort: 31007
  type: LoadBalancer
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: validacaoad-servicemonitor
  namespace: monitoring
  labels:
    release: monitoring
spec:
  selector:
    matchLabels:
      app: validacaoad
  namespaceSelector:
    matchNames:
      - producao
  endpoints:
    - port: http
      path: /actuator/prometheus
      interval: 15s
